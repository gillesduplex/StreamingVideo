<?xml version='1.0' encoding='utf-8'?>
<widget id="com.exemple.streamingvideo" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>StreamingVideo</name>
    <description>
        Découvre des vidéos, partage tes coups de cœur et rejoins la conversation.
    </description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>

    <!-- Serveur local utilisé pour les tests USB -->
    <access origin="http://192.168.1.193:3001" />

    <!-- Application locale en HTTP pour le développement -->
    <preference name="scheme" value="http" />

    <platform name="android">
        <edit-config
            file="app/src/main/AndroidManifest.xml"
            mode="merge"
            target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>

        <!-- Permissions de la caméra et du microphone -->
        
        <!-- Autorisations multimédias nécessaires
            à cette version de CameraPreview -->
        <config-file
            target="AndroidManifest.xml"
            parent="/*">

            <!-- Android 13 et versions suivantes -->
            <uses-permission
                android:name="android.permission.READ_MEDIA_IMAGES" />

            <uses-permission
                android:name="android.permission.READ_MEDIA_VIDEO" />

            <!-- Android 12 et versions antérieures -->
            <uses-permission
                android:name="android.permission.READ_EXTERNAL_STORAGE"
                android:maxSdkVersion="32" />

        </config-file>


    </platform>

    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
</widget>
